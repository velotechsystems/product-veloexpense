{
  "name": "product-veloexpense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "e2e": "npm run migrate && npm run build && npm run check:actions && npm run check:tenant && npm run check:admin && npm run check:i18n && npm run check:titles && npm run check:options && STAGE=test npm run seed && playwright test",
    "e2e:ui": "playwright test --ui",
    "start:standalone": "cp -r public .next/standalone/public 2>/dev/null; cp -r .next/static .next/standalone/.next/static && node .next/standalone/server.js",
    "check:actions": "node scripts/check-server-actions.mjs",
    "check:vendor": "node scripts/check-vendor-neutral.mjs",
    "check:harness": "node scripts/check-harness-leak.mjs",
    "check:admin": "node scripts/check-admin-gate.mjs",
    "verify:chain": "vitest run --config vitest.chain.config.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:build-fresh": "node scripts/check-build-fresh.mjs",
    "check:titles": "node scripts/check-page-titles.mjs",
    "check:options": "node scripts/check-enum-options.mjs",
    "e2e:crawl": "npm run check:build-fresh && STAGE=test npm run seed && E2E_PORT=3100 E2E_STORAGE_PORT=9501 E2E_SMTP_PORT=2625 E2E_MAIL_HTTP_PORT=2626 E2E_LEDGER_PORT=9511 E2E_LEDGER_CONTROL_PORT=9512 E2E_PLATFORM_PORT=9621 E2E_PLATFORM_CONTROL_PORT=9622 playwright test --config playwright.pseudo.config.ts",
    "check:tenant": "node scripts/check-tenant-expression.mjs",
    "check:rls-suite": "node scripts/check-rls-suite.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.9",
    "pg": "^8.13.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.19.13",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
