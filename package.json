{
  "name": "product-veloexpense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "e2e": "npm run migrate && npm run build && npm run check:actions && npm run check:tenant && npm run check:admin && npm run check:i18n && npm run check:titles && npm run check:options && STAGE=test npm run seed && playwright test",
    "e2e:ui": "playwright test --ui",
    "start:standalone": "cp -r public .next/standalone/public 2>/dev/null; cp -r .next/static .next/standalone/.next/static && node .next/standalone/server.js",
    "check:actions": "node scripts/check-server-actions.mjs",
    "check:vendor": "node scripts/check-vendor-neutral.mjs",
    "check:harness": "node scripts/check-harness-leak.mjs",
    "check:admin": "node scripts/check-admin-gate.mjs",
    "verify:chain": "vitest run --config vitest.chain.config.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:build-fresh": "node scripts/check-build-fresh.mjs",
    "check:titles": "node scripts/check-page-titles.mjs",
    "check:options": "node scripts/check-enum-options.mjs",
    "e2e:crawl": "npm run check:build-fresh && STAGE=test npm run seed && E2E_PORT=3100 E2E_STORAGE_PORT=9501 E2E_SMTP_PORT=2625 E2E_MAIL_HTTP_PORT=2626 E2E_LEDGER_PORT=9511 E2E_LEDGER_CONTROL_PORT=9512 E2E_PLATFORM_PORT=9621 E2E_PLATFORM_CONTROL_PORT=9622 playwright test --config playwright.pseudo.config.ts",
    "check:tenant": "node scripts/check-tenant-expression.mjs",
    "check:rls-suite": "node scripts/check-rls-suite.mjs",
    "check:ui-kit": "node scripts/check-ui-kit.mjs",
    "check:prisma": "node scripts/check-prisma-scope.mjs",
    "check:catalogs": "node packages/i18n/scripts/check-coverage.mjs && node packages/i18n/scripts/check-used-keys.mjs",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@formatjs/intl-localematcher": "^0.6.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "negotiator": "^1.1.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.0.15",
    "pg": "^8.13.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "intl-messageformat": "^11.2.15",
    "jsdom": "^29.1.1",
    "prisma": "^7.8.0",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.13.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    }
  }
}
