// VeloExpense — the Prisma view of the database, for code PORTED from ExpenseOS.
//
// ── THE SQL MIGRATIONS ARE THE SCHEMA OF RECORD ─────────────────────────────
// Tables, RLS policies, composite tenant FKs and grants live in
// prisma/migrations/*.sql, applied by scripts/migrate.mjs. Prisma Migrate is NOT
// used: it knows nothing of RLS, and VeloExpense's guards check the SQL. This file
// only DESCRIBES those tables to the Prisma client, and
// test/prisma-schema.db.test.ts fails if it describes a column the database does
// not have.
//
// ── MODEL AND FIELD NAMES ARE EXPENSEOS'S ───────────────────────────────────
// So ported code (`db.expenseCategory.findMany({ where: { active: true } })`)
// carries over unchanged. @@map / @map point those names at VeloExpense's
// snake_case tables and columns. Models arrive with the wave that ports their
// code (see the parity doc); this file starts with what Wave 0 needs.
//
// ── organizationId ──────────────────────────────────────────────────────────
// Every tenant model declares it with the database's default (migration 0044),
// so a ported `create` omits it and Postgres fills in the transaction's tenant.

// The client is GENERATED INTO THE REPO (lib/generated/prisma) and committed, so
// neither the Docker build nor a fresh clone needs the Prisma CLI or its engine
// download (binaries.prisma.sh). CI regenerates it and fails if the committed copy
// differs: `npm run prisma:generate && git diff --exit-code lib/generated/prisma`.
generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ExpenseOS's `ExpenseCategory`, field for field, minus its NetSuite override
// (`nsCategoryId`; VeloExpense codes to its own chart). Migration 0045 brought the
// table to this shape. `label` is `{ en, fr-CA }` JSON as in ExpenseOS; the
// database requires an English name.
model ExpenseCategory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// ExpenseOS: optional. VeloExpense: the caller may omit it and the table mints one
  /// (migration 0045's trigger), so it is never null when read. `dbgenerated` tells
  /// the client the database supplies it; the expression is not used.
  code              String   @default(dbgenerated("NULL"))
  label             Json
  glAccountId       String?  @map("gl_account_id") @db.Uuid
  glAccount         GlAccount? @relation(fields: [organizationId, glAccountId], references: [organizationId, id])
  icon              String?
  active            Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  itcGstHstRate     Int      @default(100) @map("itc_gst_hst_rate")
  itcQstRate        Int      @default(100) @map("itc_qst_rate")
  pstRecoverable    Boolean  @default(false) @map("pst_recoverable")
  requiresAttendees Boolean  @default(false) @map("requires_attendees")
  isMileage         Boolean  @default(false) @map("is_mileage")
  acceptsTip        Boolean  @default(false) @map("accepts_tip")
  color             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lineItems ExpenseLineItem[]

  @@unique([organizationId, id])
  @@map("expense_category")
}

// VeloExpense's chart of accounts (`gl_account`) — what ExpenseOS's
// `NetSuiteAccount` is to its categories. Only the columns the category port reads.
// `isActive` is ExpenseOS's name for VeloExpense's `active`.
model GlAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  number         String
  name           String
  type           String
  isPostable     Boolean  @default(true) @map("is_postable")
  isActive       Boolean  @default(true) @map("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenseLines      ExpenseLineItem[] @relation("ExpenseLineGlAccount")
  expenseCategories ExpenseCategory[]

  @@unique([organizationId, id])
  @@map("gl_account")
}

// ── The expense core (Wave 2) ───────────────────────────────────────────────
// ExpenseOS's `ExpenseReport`, `Expense`, `ExpenseLineItem`, `Receipt`,
// `ExpenseAllocation`, `ExpenseAttendee` and `TaxJurisdiction`, on the tables
// migration 0054 reshaped in place (d22). Shared VeloExpense differences:
//   · per tenant: the database's foreign keys are composite through organization_id
//     (0019). Relations name only the id, which is all Prisma needs to join and nest
//     (as for the mileage models); `category` keeps the composite it already had;
//   · `currencyId` is the ISO code in `currency_code` (as `homeCurrencyId`, 0048);
//   · ExpenseOS's Postgres enums are text with a CHECK here, so those fields are
//     `String` — except the report status, which VeloExpense already had as an enum;
//   · only the relations the ported code reaches are described. ExpenseOS's
//     violations, fraud flags, determinations, external ids, approval instance and
//     travel request arrive with their own waves; VeloExpense's own columns on these
//     tables (the report's business unit, department and reimbursement stamp, the
//     expense's notes, the line's tax_minor, the receipt's upload status) are left
//     to VeloExpense's SQL readers.

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  REIMBURSED

  @@map("expense_report_status")
}

model ExpenseReport {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String              @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// VeloExpense: nullable and unique per tenant; ExpenseOS mints it from a sequence.
  number                 String?
  title                  String
  purpose                String?
  status                 ExpenseReportStatus @default(DRAFT)
  totalMinor             BigInt              @default(0) @map("total_minor")
  /// VeloExpense: the ISO code (`currency_code`), not a uuid.
  currencyId             String              @map("currency_code")
  currency               Currency            @relation("ExpenseReportCurrency", fields: [currencyId], references: [code], onDelete: Restrict)
  submitterId            String              @map("submitter_id") @db.Uuid
  submitter              User                @relation("ReportSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  metadata               Json                @default("{}")
  fxRateOverride         Decimal?            @map("fx_rate_override") @db.Decimal(18, 8)
  /// VeloExpense: a foreign key to `currency` (ExpenseOS: a bare code).
  fxRateOverrideCurrency String?             @map("fx_rate_override_currency")
  fxRateOverrideAt       DateTime?           @map("fx_rate_override_at") @db.Timestamptz(6)
  fxRateOverrideById     String?             @map("fx_rate_override_by_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt            DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedAt             DateTime?           @map("approved_at") @db.Timestamptz(6)
  /// ExpenseOS's `approvalInstanceId`: the approval run deciding the report (0059). The
  /// database's key is composite; only the scalar is described.
  approvalInstanceId     String?             @map("approval_instance_id") @db.Uuid

  expenses Expense[]

  @@unique([organizationId, id])
  @@map("expense_report")
}

model Expense {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String        @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  reportId               String        @map("report_id") @db.Uuid
  report                 ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// The report's submitter. VeloExpense: a row inserted without one takes it (0054's
  /// trigger), for VeloExpense's own writer.
  ownerId                String        @map("owner_id") @db.Uuid
  owner                  User          @relation("ExpenseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  merchant               String?
  placeText              String?       @map("place_text")
  /// VeloExpense: `txn_date`, a date, and nullable (VeloExpense's writer allows a
  /// blank one); ExpenseOS's `date` is a required timestamp.
  date                   DateTime?     @map("txn_date") @db.Date
  /// Entry total in `currency`. Must equal the sum of its line items.
  amountMinor            BigInt        @default(0) @map("amount_minor")
  /// VeloExpense: the ISO code (`currency_code`), not a uuid.
  currencyId             String        @map("currency_code")
  currency               Currency      @relation("ExpenseCurrency", fields: [currencyId], references: [code], onDelete: Restrict)
  /// OUT_OF_POCKET | VIRTUAL_CARD | PHYSICAL_CARD (a CHECK in the table).
  paymentMethod          String        @default("OUT_OF_POCKET") @map("payment_method")
  purpose                String?
  explanation            String?
  subtotalMinor          BigInt?       @map("subtotal_minor")
  fxRate                 Decimal?      @map("fx_rate") @db.Decimal(18, 8)
  /// MANUAL | EXTRACTED | CALCULATED (a CHECK in the table).
  fxRateSource           String?       @map("fx_rate_source")
  homeCurrency           String?       @map("home_currency")
  homeAmountMinor        BigInt?       @map("home_amount_minor")
  taxGstHstMinor         BigInt?       @map("tax_gst_hst_minor")
  taxQstMinor            BigInt?       @map("tax_qst_minor")
  taxPstMinor            BigInt?       @map("tax_pst_minor")
  recoverableGstHstMinor BigInt?       @map("recoverable_gst_hst_minor")
  recoverableQstMinor    BigInt?       @map("recoverable_qst_minor")
  /// MANUAL | EXTRACTED | CALCULATED (a CHECK in the table).
  taxSource              String        @default("CALCULATED") @map("tax_source")
  taxJurisdictionId      String?          @map("tax_jurisdiction_id") @db.Uuid
  taxJurisdiction        TaxJurisdiction? @relation(fields: [taxJurisdictionId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lineItems   ExpenseLineItem[]
  receipts    Receipt[]
  /// w3-02a (0057): what each reading pass concluded, and the merchant's printed number.
  determinations ExpenseDetermination[]
  externalIds    ExpenseExternalId[]
  attendees   ExpenseAttendee[]
  allocations ExpenseAllocation[]

  @@unique([organizationId, id])
  @@map("expense")
}

/// VeloExpense: no NetSuite class or NetSuite business unit (0054).
model ExpenseAllocation {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  expenseId      String        @map("expense_id") @db.Uuid
  expense        Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// Basis points of the expense total; an expense's rows sum to 10000.
  percentBp      Int           @map("percent_bp")
  businessUnitId String?       @map("business_unit_id") @db.Uuid
  businessUnit   BusinessUnit? @relation("ExpenseAllocationBusinessUnit", fields: [businessUnitId], references: [id], onDelete: Restrict)
  departmentId   String?       @map("department_id") @db.Uuid
  department     Department?   @relation("ExpenseAllocationDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@map("expense_allocation")
}

model ExpenseAttendee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  expenseId      String   @map("expense_id") @db.Uuid
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name           String
  company        String?
  isExternal     Boolean  @default(false) @map("is_external")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@map("expense_attendee")
}

model ExpenseLineItem {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String          @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  expenseId               String          @map("expense_id") @db.Uuid
  expense                 Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// STANDARD | STANDARD_WITH_TIP | MILEAGE (a CHECK in the table).
  kind                    String          @default("STANDARD")
  payload                 Json?
  categoryId              String          @map("category_id") @db.Uuid
  category                ExpenseCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  /// VeloExpense: the tenant's `gl_account` (ExpenseOS: NetSuiteAccount), held
  /// postable by a trigger (0014).
  glAccountId             String?         @map("gl_account_id") @db.Uuid
  glAccount               GlAccount?      @relation("ExpenseLineGlAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  amountMinor             BigInt          @map("amount_minor")
  /// VeloExpense: the existing `description` column.
  notes                   String?         @map("description")
  mileageDistance         Decimal?        @map("mileage_distance") @db.Decimal(12, 2)
  /// KM | MI (a CHECK in the table).
  mileageUnit             String?         @map("mileage_unit")
  mileageRateId           String?         @map("mileage_rate_id") @db.Uuid
  mileageRate             MileageRate?    @relation(fields: [mileageRateId], references: [id], onDelete: SetNull)
  mileageYtdBefore        Decimal?        @map("mileage_ytd_before") @db.Decimal(12, 2)
  mileageBreakdown        Json?           @map("mileage_breakdown")
  mileageRoute            Json?           @map("mileage_route")
  mileageDistanceOverride Decimal?        @map("mileage_distance_override") @db.Decimal(12, 2)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@map("expense_line_item")
}

model Receipt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  expenseId      String?  @map("expense_id") @db.Uuid
  expense        Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// RECEIPT | ITEMIZED_BILL | CARD_COPY | BANK_STATEMENT | OTHER (a CHECK in the table).
  kind           String   @default("OTHER")
  /// VeloExpense: 'PENDING' until the object is verified in storage, then 'STORED'. ExpenseOS
  /// has no such column — its row is written only after the upload — so the ported reads
  /// show STORED receipts only, and the ported writer stores rows already verified (w2-09).
  status         String   @default("PENDING")
  /// VeloExpense: unique per tenant, not globally.
  s3Key          String   @map("s3_key")
  filename       String
  contentType    String   @map("content_type")
  /// VeloExpense: nullable (set once the upload is stored).
  sizeBytes      Int?     @map("size_bytes")
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  uploadedBy     User     @relation("ReceiptUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt     DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  /// w3-01: the receipt's reading (0056), one per receipt.
  extraction     DocumentExtraction?
  /// w3-02a (0057): the transaction number printed on it.
  externalIds    ReceiptExternalId[]

  @@unique([organizationId, s3Key])
  /// w3-01 (0056): the key document_extraction's tenant foreign key references.
  @@unique([organizationId, id])
  @@map("receipt")
}

/// ExpenseOS's DocumentExtraction (0056, w3-01): one reading of one receipt — the scan's
/// verdict, the model's extraction and its confidence, and a reviewer's sign-off.
/// VeloExpense: receipts only (no virtual-card attachment), per tenant; ExpenseOS's
/// DocScanStatus / DocExtractStatus are text under a CHECK, as the Wave 2 tables keep
/// ExpenseOS's enums.
model DocumentExtraction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  receiptId      String    @unique @map("receipt_id") @db.Uuid
  receipt        Receipt   @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Cascade)
  /// PENDING | SCANNING | CLEAN | INFECTED | FAILED (a CHECK in the table).
  scanStatus     String    @default("PENDING") @map("scan_status")
  /// PENDING | EXTRACTING | EXTRACTED | FAILED (a CHECK in the table).
  status         String    @default("PENDING")
  model          String?
  modelVersion   String?   @map("model_version")
  confidence     Decimal?  @db.Decimal(4, 3)
  data           Json?
  rawResponse    Json?     @map("raw_response")
  error          String?
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  /// VeloExpense: ExpenseOS's `reviewedBy`, with the tenant key to app_user.
  reviewedBy     String?   @map("reviewed_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  /// The one-to-one key Prisma needs for the tenant relation (0056 declares it too).
  @@unique([organizationId, receiptId])
  @@map("document_extraction")
}

/// ExpenseOS's ExpenseDetermination (0057, w3-02a): what a reading pass concluded for the
/// whole expense, and the field-level human edits made after it.
model ExpenseDetermination {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  expenseId      String   @map("expense_id") @db.Uuid
  expense        Expense  @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Cascade)
  /// The document set this pass actually saw.
  receiptIds     String[] @map("receipt_ids") @db.Uuid
  /// What the pass concluded for the whole expense: header, lines, tax, FX.
  proposed       Json
  /// Field-level human edits made after this pass.
  overrides      Json     @default("{}")
  model          String?
  modelVersion   String?  @map("model_version")
  confidence     Decimal? @db.Decimal(4, 3)
  /// Set when a newer pass replaces this one. Null = current. VeloExpense: a bare id in
  /// Prisma, as ExpenseOS's; 0057 keys it to a row of the same tenant.
  supersededById String?  @unique @map("superseded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([expenseId, createdAt])
  @@map("expense_determination")
}

/// ExpenseOS's ReceiptExternalId (0057, w3-02a): a number printed on one document.
model ReceiptExternalId {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String           @map("source_id") @db.Uuid
  sourceValue    String           @map("source_value")
  receiptId      String           @map("receipt_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid
  source         ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  receipt        Receipt          @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue, receiptId])
  @@index([receiptId])
  @@index([sourceId, sourceValue])
  @@map("receipt_external_id")
}

/// ExpenseOS's ExpenseExternalId (0057, w3-02a): the number a determination settled on.
model ExpenseExternalId {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String           @map("source_id") @db.Uuid
  sourceValue    String           @map("source_value")
  expenseId      String           @map("expense_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid
  source         ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  expense        Expense          @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue, expenseId])
  @@index([expenseId])
  @@index([sourceId, sourceValue])
  @@map("expense_external_id")
}

/// VeloLedger's ai_usage (0057, w3-02a, d43): one row per model call. Not from ExpenseOS.
model AiUsage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  feature        String
  model          String
  inputTokens    Int       @default(0) @map("input_tokens")
  outputTokens   Int       @default(0) @map("output_tokens")
  costMicroUsd   BigInt    @default(0) @map("cost_micro_usd")
  /// Included (false) or reported to the platform as credits (true) — d43.
  metered        Boolean
  receiptId      String?   @map("receipt_id") @db.Uuid
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  requestId      String    @map("request_id")
  reportedAt     DateTime? @map("reported_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@map("ai_usage")
}

/// GLOBAL and platform-seeded (d24): the app role can read it and cannot write it.
model TaxJurisdiction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode  String   @map("country_code")
  code         String
  label        Json
  gstRate      Decimal  @default(0) @map("gst_rate") @db.Decimal(6, 3)
  hstRate      Decimal  @default(0) @map("hst_rate") @db.Decimal(6, 3)
  pstRate      Decimal  @default(0) @map("pst_rate") @db.Decimal(6, 3)
  qstRate      Decimal  @default(0) @map("qst_rate") @db.Decimal(6, 3)
  salesTaxRate Decimal  @default(0) @map("sales_tax_rate") @db.Decimal(6, 3)
  taxType      String   @map("tax_type")
  version      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenses Expense[]

  @@unique([countryCode, code])
  @@map("tax_jurisdiction")
}

// ExpenseOS's `User`, on VeloExpense's `app_user`. Wave 0 carries the columns the shell
// (canSeeOthers) and the user picker read, and the ones whose names already match
// ExpenseOS's. VeloExpense differences:
//   · the name is one column (`display_name`, here `name`), not firstName/lastName;
//   · the role is a text column (`role`), not a roleId into a roles table;
//   · employeeStatus is text with a CHECK, not a Prisma enum.
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  email          String
  /// ExpenseOS has firstName/lastName; VeloExpense has one display name.
  name           String?   @map("display_name")
  /// ExpenseOS's EmployeeStatus enum; text with a CHECK here (ACTIVE, ON_LEAVE, DEACTIVATED).
  employeeStatus String    @default("ACTIVE") @map("employee_status")
  /// ISO-3166-1 alpha-2 country code — ExpenseOS's `User.country`, which mileage pricing
  /// reads (w2-10). Backfilled from the person's legal entity (0055).
  country        String?
  managerId      String?   @map("manager_id") @db.Uuid
  /// w4-00b: ExpenseOS's `manager` / `directReports`; the engine counts direct reports.
  /// The database's key is composite (0019); the relation is on the id alone.
  manager        User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReports  User[]    @relation("UserManager")
  departmentId   String?   @map("department_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  legalEntityId  String?   @map("legal_entity_id") @db.Uuid
  /// ExpenseOS's `entity` (the person's legal entity): the reader's and the payee's home
  /// currency come through it (Wave 2). The database's FK is composite (0019).
  entity         LegalEntity? @relation("UserEntity", fields: [legalEntityId], references: [id])
  /// ExpenseOS's `jobLevelId` (migration 0050). Nothing assigns it yet.
  jobLevelId     String?   @map("job_level_id") @db.Uuid
  /// w4-00b: the approval engine reads the level's sortOrder. The database's key is
  /// composite (0050); the relation is on the id alone, as the approval task's.
  jobLevel       JobLevel? @relation("UserJobLevel", fields: [jobLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// VeloExpense's role (EMPLOYEE | MANAGER | ADMIN, 0004), where ExpenseOS has `roleId`.
  /// The approval engine maps it to an ExpenseOS system role (`systemRoleFor`) until the
  /// role builder (w4-10).
  role           String    @default("EMPLOYEE")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reports      ExpenseReport[] @relation("ReportSubmitter")
  expenses     Expense[]       @relation("ExpenseOwner")
  receipts     Receipt[]       @relation("ReceiptUploader")
  mileageRates MileageRateSubject[] @relation("MileageRateSubject")
  /// w4-00a: the workflow engine's tasks (0058).
  approvalTasksAssigned ApprovalTask[] @relation("ApprovalTaskAssignee")
  approvalTasksDecided  ApprovalTask[] @relation("ApprovalTaskDecider")
  /// w4-00b: the engine's delegation lookups.
  delegationsFrom       Delegation[]   @relation("DelegationFrom")
  delegationsTo         Delegation[]   @relation("DelegationTo")

  @@map("app_user")
}

// ExpenseOS's `BusinessUnit` (Wave 1). Migration 0047 brought `business_unit` to this
// shape: `label` and `description` are `{ en, fr-CA }` JSON, and `active` is the soft
// toggle. VeloExpense differences:
//   · no createdBy / updatedBy columns (the audit chain records who, as for categories);
//   · the English name is unique per tenant (0047's index), as it always was here.
// The back-relations to ExpenseOS's other models arrive with those models.
model BusinessUnit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
