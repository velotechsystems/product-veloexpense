  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source      ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  legalEntity LegalEntity      @relation(fields: [organizationId, legalEntityId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue])
  @@index([legalEntityId])
  @@map("legal_entity_external_id")
}

// VeloExpense's shared `currency` reference table (migration 0001; not tenant-scoped).
// ExpenseOS's `Currency` has a uuid id, a localized label, a symbol and an active flag;
// VeloExpense's row is the ISO code, an English name and the minor units. Only what the
// ported code reads is described here.
// ExpenseOS's `FxRate` (Wave 1), migration 0051. VeloExpense differences:
//   · per tenant (`organization_id`, RLS, d18), so the key leads with the tenant;
//   · `source` (MANUAL / SYNC / SEED, from 0015) and `created_at` are VeloExpense's;
//   · `as_of`, the UTC day of `fetchedAt`, is a generated column VeloExpense's own SQL
//     readers use. It is not described here: Prisma cannot write it, and ported code
//     never reads it.
model FxRate {
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  base           String
  quote          String
  /// Rate is `quote per 1 base` (e.g. base=USD, quote=CAD → "CAD per 1 USD").
  rate           Decimal  @db.Decimal(18, 8)
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  source         String   @default("MANUAL")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([organizationId, base, quote, fetchedAt])
  @@index([organizationId, base, quote, fetchedAt(sort: Desc)], map: "fx_rate_pair_idx")
  @@index([organizationId, fetchedAt], map: "fx_rate_fetched_at_idx")
  @@map("fx_rate")
}

// ExpenseOS's `MileageRate`, `MileageRateTier` and `MileageRateSubject` (Wave 1),
// migration 0052. VeloExpense differences:
//   · per tenant; the database's foreign keys are composite through organization_id
//     (0019). The relations below name only the id, which is all Prisma needs to join
//     and to nest the creates ExpenseOS's router makes;
//   · `unit` is text with a CHECK ('KM' | 'MI'), not a Prisma enum;
//   · `glAccountId` is the tenant's `gl_account` (ExpenseOS: NetSuiteAccount). Only the
//     scalar is described, as is `supersededById`: the router reads and writes them and
//     never their relations.
model MileageRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  country        String
  /// KM | MI (a CHECK in the table).
  unit           String
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  supersededById String?   @unique @map("superseded_by_id") @db.Uuid
  glAccountId    String?   @map("gl_account_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid

  lineItems ExpenseLineItem[]
  tiers    MileageRateTier[]
  subjects MileageRateSubject[]

  @@unique([organizationId, id])
  @@map("mileage_rate")
}

model MileageRateTier {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  rateId         String      @map("rate_id") @db.Uuid
  rate           MileageRate @relation(fields: [rateId], references: [id], onDelete: Cascade)
  /// Inclusive lower bound of the band, in the rule's unit.
  fromDistance   Decimal     @map("from_distance") @db.Decimal(12, 2)
  rateMinor      BigInt      @map("rate_minor")

  @@unique([rateId, fromDistance])
  @@map("mileage_rate_tier")
}

model MileageRateSubject {
  organizationId String      @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  rateId         String      @map("rate_id") @db.Uuid
  rate           MileageRate @relation(fields: [rateId], references: [id], onDelete: Cascade)
  userId         String      @map("user_id") @db.Uuid
  user           User        @relation("MileageRateSubject", fields: [userId], references: [id], onDelete: Cascade)

  @@id([rateId, userId])
  @@map("mileage_rate_subject")
}

