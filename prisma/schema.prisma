// VeloExpense — the Prisma view of the database, for code PORTED from ExpenseOS.
//
// ── THE SQL MIGRATIONS ARE THE SCHEMA OF RECORD ─────────────────────────────
// Tables, RLS policies, composite tenant FKs and grants live in
// prisma/migrations/*.sql, applied by scripts/migrate.mjs. Prisma Migrate is NOT
// used: it knows nothing of RLS, and VeloExpense's guards check the SQL. This file
// only DESCRIBES those tables to the Prisma client, and
// test/prisma-schema.db.test.ts fails if it describes a column the database does
// not have.
//
// ── MODEL AND FIELD NAMES ARE EXPENSEOS'S ───────────────────────────────────
// So ported code (`db.expenseCategory.findMany({ where: { active: true } })`)
// carries over unchanged. @@map / @map point those names at VeloExpense's
// snake_case tables and columns. Models arrive with the wave that ports their
// code (see the parity doc); this file starts with what Wave 0 needs.
//
// ── organizationId ──────────────────────────────────────────────────────────
// Every tenant model declares it with the database's default (migration 0044),
// so a ported `create` omits it and Postgres fills in the transaction's tenant.

// The client is GENERATED INTO THE REPO (lib/generated/prisma) and committed, so
// neither the Docker build nor a fresh clone needs the Prisma CLI or its engine
// download (binaries.prisma.sh). CI regenerates it and fails if the committed copy
// differs: `npm run prisma:generate && git diff --exit-code lib/generated/prisma`.
generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ExpenseOS's `ExpenseCategory`, field for field, minus its NetSuite override
// (`nsCategoryId`; VeloExpense codes to its own chart). Migration 0045 brought the
// table to this shape. `label` is `{ en, fr-CA }` JSON as in ExpenseOS; the
// database requires an English name.
model ExpenseCategory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// ExpenseOS: optional. VeloExpense: the caller may omit it and the table mints one
  /// (migration 0045's trigger), so it is never null when read. `dbgenerated` tells
  /// the client the database supplies it; the expression is not used.
  code              String   @default(dbgenerated("NULL"))
  label             Json
  glAccountId       String?  @map("gl_account_id") @db.Uuid
  glAccount         GlAccount? @relation(fields: [organizationId, glAccountId], references: [organizationId, id])
  icon              String?
  active            Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  itcGstHstRate     Int      @default(100) @map("itc_gst_hst_rate")
  itcQstRate        Int      @default(100) @map("itc_qst_rate")
  pstRecoverable    Boolean  @default(false) @map("pst_recoverable")
  requiresAttendees Boolean  @default(false) @map("requires_attendees")
  isMileage         Boolean  @default(false) @map("is_mileage")
  acceptsTip        Boolean  @default(false) @map("accepts_tip")
  color             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lineItems ExpenseLineItem[]

  @@unique([organizationId, id])
  @@map("expense_category")
}

// VeloExpense's chart of accounts (`gl_account`) — what ExpenseOS's
// `NetSuiteAccount` is to its categories. Only the columns the category port reads.
// `isActive` is ExpenseOS's name for VeloExpense's `active`.
model GlAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  number         String
  name           String
  type           String
  isPostable     Boolean  @default(true) @map("is_postable")
  isActive       Boolean  @default(true) @map("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenseCategories ExpenseCategory[]

  @@unique([organizationId, id])
  @@map("gl_account")
}

// Only so `_count: { lineItems }` works — ExpenseOS's guard on changing a category's
// kind once anything is filed against it. The line-item port (Wave 2) fills it in.
model ExpenseLineItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  categoryId     String @map("category_id") @db.Uuid
  /// ExpenseOS's `mileageRateId` (migration 0052): the rule a mileage claim was priced
  /// under. Nothing prices one yet (Wave 2); the mileage router's delete guard reads it.
  mileageRateId  String? @map("mileage_rate_id") @db.Uuid

  category ExpenseCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id])

  @@map("expense_line_item")
}

// ExpenseOS's `User`, on VeloExpense's `app_user`. Wave 0 carries the columns the shell
// (canSeeOthers) and the user picker read, and the ones whose names already match
// ExpenseOS's. VeloExpense differences:
//   · the name is one column (`display_name`, here `name`), not firstName/lastName;
//   · the role is a text column (`role`), not a roleId into a roles table;
//   · employeeStatus is text with a CHECK, not a Prisma enum.
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  email          String
  /// ExpenseOS has firstName/lastName; VeloExpense has one display name.
  name           String?   @map("display_name")
  /// ExpenseOS's EmployeeStatus enum; text with a CHECK here (ACTIVE, ON_LEAVE, DEACTIVATED).
  employeeStatus String    @default("ACTIVE") @map("employee_status")
  managerId      String?   @map("manager_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  legalEntityId  String?   @map("legal_entity_id") @db.Uuid
  /// ExpenseOS's `jobLevelId` (migration 0050). Nothing assigns it yet.
  jobLevelId     String?   @map("job_level_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mileageRates MileageRateSubject[] @relation("MileageRateSubject")

  @@map("app_user")
}

// ExpenseOS's `BusinessUnit` (Wave 1). Migration 0047 brought `business_unit` to this
// shape: `label` and `description` are `{ en, fr-CA }` JSON, and `active` is the soft
// toggle. VeloExpense differences:
//   · no createdBy / updatedBy columns (the audit chain records who, as for categories);
//   · the English name is unique per tenant (0047's index), as it always was here.
// The back-relations to ExpenseOS's other models arrive with those models.
model BusinessUnit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  label          Json
  description    Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds BusinessUnitExternalId[]

  @@unique([organizationId, id])
  @@map("business_unit")
}

// ExpenseOS's `ExternalIdSource`: an outside system a tenant federates to. VeloExpense:
// per tenant (`code` is unique within the organization, not globally), and without
// ExpenseOS's `integrationId` (migration 0047).
model ExternalIdSource {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  code           String
  label          Json
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  businessUnitAliases BusinessUnitExternalId[]
  legalEntityAliases  LegalEntityExternalId[]
  departmentAliases   DepartmentExternalId[]
  jobLevelAliases     JobLevelExternalId[]
  fiscalYearAliases   FiscalYearExternalId[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("external_id_source")
}

// ExpenseOS's `BusinessUnitExternalId`: one business unit's id in one outside system.
model BusinessUnitExternalId {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  sourceValue    String   @map("source_value")
  businessUnitId String   @map("business_unit_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source       ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  businessUnit BusinessUnit     @relation(fields: [organizationId, businessUnitId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue])
  @@index([businessUnitId])
  @@map("business_unit_external_id")
}

// ExpenseOS's `LegalEntity` (Wave 1). Migration 0048 brought `legal_entity` to this shape.
// VeloExpense differences:
//   · the home currency is VeloExpense's `currency_code`, a foreign key to the shared
//     `currency` table by ISO code. ExpenseOS's `homeCurrencyId` is a uuid FK to its
//     Currency row; VeloExpense's currency row is keyed by the code, so the field keeps
//     ExpenseOS's name and holds the code;
//   · no createdBy / updatedBy (the audit chain records who);
//   · the English name is unique per tenant (0048's index).
model LegalEntity {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  label          Json
  description    Json?
  /// ISO-3166-1 alpha-2 country code (e.g. "CA", "US").
  country        String?
  /// VeloExpense: the ISO-4217 code (the `currency` row's key), not a uuid.
  homeCurrencyId String?   @map("currency_code")
  homeCurrency   Currency? @relation(fields: [homeCurrencyId], references: [code], onDelete: Restrict)
  active         Boolean   @default(true)
  itcRecoverable Boolean   @default(true) @map("itc_recoverable")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds LegalEntityExternalId[]

  @@unique([organizationId, id])
  @@map("legal_entity")
}

// ExpenseOS's `LegalEntityExternalId`: one legal entity's id in one outside system.
model LegalEntityExternalId {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  sourceValue    String   @map("source_value")
  legalEntityId  String   @map("legal_entity_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source      ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  legalEntity LegalEntity      @relation(fields: [organizationId, legalEntityId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue])
  @@index([legalEntityId])
  @@map("legal_entity_external_id")
}

// VeloExpense's shared `currency` reference table (migration 0001; not tenant-scoped).
// ExpenseOS's `Currency` has a uuid id, a localized label, a symbol and an active flag;
// VeloExpense's row is the ISO code, an English name and the minor units. Only what the
// ported code reads is described here.
// ExpenseOS's `FxRate` (Wave 1), migration 0051. VeloExpense differences:
//   · per tenant (`organization_id`, RLS, d18), so the key leads with the tenant;
//   · `source` (MANUAL / SYNC / SEED, from 0015) and `created_at` are VeloExpense's;
//   · `as_of`, the UTC day of `fetchedAt`, is a generated column VeloExpense's own SQL
//     readers use. It is not described here: Prisma cannot write it, and ported code
//     never reads it.
model FxRate {
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  base           String
  quote          String
  /// Rate is `quote per 1 base` (e.g. base=USD, quote=CAD → "CAD per 1 USD").
  rate           Decimal  @db.Decimal(18, 8)
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  source         String   @default("MANUAL")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([organizationId, base, quote, fetchedAt])
  @@index([organizationId, base, quote, fetchedAt(sort: Desc)], map: "fx_rate_pair_idx")
  @@index([organizationId, fetchedAt], map: "fx_rate_fetched_at_idx")
  @@map("fx_rate")
}

// ExpenseOS's `MileageRate`, `MileageRateTier` and `MileageRateSubject` (Wave 1),
// migration 0052. VeloExpense differences:
//   · per tenant; the database's foreign keys are composite through organization_id
//     (0019). The relations below name only the id, which is all Prisma needs to join
//     and to nest the creates ExpenseOS's router makes;
//   · `unit` is text with a CHECK ('KM' | 'MI'), not a Prisma enum;
//   · `glAccountId` is the tenant's `gl_account` (ExpenseOS: NetSuiteAccount). Only the
//     scalar is described, as is `supersededById`: the router reads and writes them and
//     never their relations.
model MileageRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  country        String
  /// KM | MI (a CHECK in the table).
  unit           String
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  supersededById String?   @unique @map("superseded_by_id") @db.Uuid
  glAccountId    String?   @map("gl_account_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid

  tiers    MileageRateTier[]
  subjects MileageRateSubject[]

  @@unique([organizationId, id])
  @@map("mileage_rate")
}

model MileageRateTier {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  rateId         String      @map("rate_id") @db.Uuid
  rate           MileageRate @relation(fields: [rateId], references: [id], onDelete: Cascade)
  /// Inclusive lower bound of the band, in the rule's unit.
  fromDistance   Decimal     @map("from_distance") @db.Decimal(12, 2)
  rateMinor      BigInt      @map("rate_minor")

  @@unique([rateId, fromDistance])
  @@map("mileage_rate_tier")
}

model MileageRateSubject {
  organizationId String      @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  rateId         String      @map("rate_id") @db.Uuid
  rate           MileageRate @relation(fields: [rateId], references: [id], onDelete: Cascade)
  userId         String      @map("user_id") @db.Uuid
  user           User        @relation("MileageRateSubject", fields: [userId], references: [id], onDelete: Cascade)

  @@id([rateId, userId])
  @@map("mileage_rate_subject")
}

// ExpenseOS's `PerDiemRate` (Wave 1), migration 0053. VeloExpense differences: per
// tenant (composite tenant FKs in the database; only the scalars are described, which
// is all the router reads and writes), and `currencyId` is the ISO code in
// `currency_code` — VeloExpense keys a currency by its code (as `homeCurrencyId`, 0048).
model PerDiemRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  country        String
  city           String
  categoryId     String    @map("category_id") @db.Uuid
  amountMinor    BigInt    @map("amount_minor")
  firstLastDay   Boolean   @default(false) @map("first_last_day")
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  jobLevelId     String?   @map("job_level_id") @db.Uuid
  legalEntityId  String?   @map("legal_entity_id") @db.Uuid
  businessUnitId String?   @map("business_unit_id") @db.Uuid
  /// VeloExpense: the ISO code (`currency_code`), not a uuid.
  currencyId     String?   @map("currency_code")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@map("per_diem_rate")
}

model Currency {
  code      String @id
  name      String
  minorUnit Int    @map("minor_unit") @db.SmallInt

  legalEntities LegalEntity[]

  @@map("currency")
}

// ExpenseOS's `Department` (Wave 1). Migration 0049 brought `department` to this shape.
// VeloExpense differences:
//   · the parent is VeloExpense's `parent_department_id` (ExpenseOS's `parentId`), a
//     composite tenant FK (0019). Only the scalar is described: ported code reads and
//     writes `parentId` and walks it with `findUnique`, and never uses ExpenseOS's
//     `parent` / `children` relations;
//   · no createdBy / updatedBy (the audit chain records who);
//   · the English name is unique per tenant (0049's index).
model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  label          Json
  description    Json?
  parentId       String?  @map("parent_department_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds DepartmentExternalId[]

  @@unique([organizationId, id])
  @@map("department")
}

// ExpenseOS's `DepartmentExternalId`: one department's id in one outside system.
model DepartmentExternalId {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  sourceValue    String   @map("source_value")
  departmentId   String   @map("department_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source     ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  department Department       @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue])
  @@index([departmentId])
  @@map("department_external_id")
}

// ExpenseOS's `JobLevel` (Wave 1, migration 0050): the approval-tier ladder. VeloExpense
// differences: `track` is text with a CHECK (ExpenseOS's `JobLevelTrack` enum values),
// and `code` is unique per tenant, not globally.
model JobLevel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  code           String
  /// INDIVIDUAL_CONTRIBUTOR | MANAGER | EXECUTIVE | BOARD (a CHECK in the table).
  track          String
  label          Json
  sortOrder      Int      @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds JobLevelExternalId[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("job_level")
}

model JobLevelExternalId {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  sourceValue    String   @map("source_value")
  jobLevelId     String   @map("job_level_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source   ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  jobLevel JobLevel         @relation(fields: [organizationId, jobLevelId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue])
  @@index([jobLevelId])
  @@map("job_level_external_id")
}

// ExpenseOS's `FiscalYear` (Wave 1, migration 0050). VeloExpense: the dates are
// `date` columns; at most one year per tenant is current (a partial unique index).
model FiscalYear {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  label          Json
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isCurrent      Boolean  @default(false) @map("is_current")
  closed         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds FiscalYearExternalId[]

  @@unique([organizationId, id])
  @@map("fiscal_year")
}

model FiscalYearExternalId {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  sourceValue    String   @map("source_value")
  fiscalYearId   String   @map("fiscal_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source     ExternalIdSource @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  fiscalYear FiscalYear       @relation(fields: [organizationId, fiscalYearId], references: [organizationId, id], onDelete: Cascade)

  @@unique([sourceId, sourceValue])
  @@index([fiscalYearId])
  @@map("fiscal_year_external_id")
}
