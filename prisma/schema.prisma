// ExpenseOS's `LegalEntity` (Wave 1). Migration 0048 brought `legal_entity` to this shape.
// VeloExpense differences:
//   · the home currency is VeloExpense's `currency_code`, a foreign key to the shared
//     `currency` table by ISO code. ExpenseOS's `homeCurrencyId` is a uuid FK to its
//     Currency row; VeloExpense's currency row is keyed by the code, so the field keeps
//     ExpenseOS's name and holds the code;
//   · no createdBy / updatedBy (the audit chain records who);
//   · the English name is unique per tenant (0048's index).
model LegalEntity {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  label          Json
  description    Json?
  /// ISO-3166-1 alpha-2 country code (e.g. "CA", "US").
  country        String?
  /// VeloExpense: the ISO-4217 code (the `currency` row's key), not a uuid.
  homeCurrencyId String?   @map("currency_code")
  homeCurrency   Currency? @relation(fields: [homeCurrencyId], references: [code], onDelete: Restrict)
  active         Boolean   @default(true)
  itcRecoverable Boolean   @default(true) @map("itc_recoverable")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds LegalEntityExternalId[]
  users       User[]                  @relation("UserEntity")

  @@unique([organizationId, id])
  @@map("legal_entity")
}

// ExpenseOS's `LegalEntityExternalId`: one legal entity's id in one outside system.
model LegalEntityExternalId {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  sourceValue    String   @map("source_value")
  legalEntityId  String   @map("legal_entity_id") @db.Uuid
