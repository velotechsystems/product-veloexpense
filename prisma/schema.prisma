// ── Approval workflows (Wave 4, w4-00a, migration 0058, d50) ─────────────────
// ExpenseOS's ApprovalWorkflow / ApprovalWorkflowVersion / ApprovalInstance / ApprovalTask
// (550b2945), per tenant. Its enums are text under CHECKs here, as the Wave 2 tables keep
// them. Nothing reads these until the interpreter (w4-00b); the ladder (0008) still runs
// every approval until the cutover.

/// ExpenseOS's ApprovalWorkflow. `key` is unique within the tenant.
model ApprovalWorkflow {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  key              String
  name             String
  description      String?
  /// EXPENSE_REPORT | TRAVEL_REQUEST (a CHECK in the table).
  subjectType      String   @map("subject_type")
  callable         Boolean  @default(false)
  isDefault        Boolean  @default(false) @map("is_default")
  priority         Int      @default(0)
  active           Boolean  @default(true)
  /// A plain pointer to the in-effect PUBLISHED version, as ExpenseOS has it (no relation).
  currentVersionId String?  @map("current_version_id") @db.Uuid
  versions         ApprovalWorkflowVersion[] @relation("WorkflowVersions")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("approval_workflow")
}

/// ExpenseOS's ApprovalWorkflowVersion.
model ApprovalWorkflowVersion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  workflowId     String           @map("workflow_id") @db.Uuid
  workflow       ApprovalWorkflow @relation("WorkflowVersions", fields: [organizationId, workflowId], references: [organizationId, id], onDelete: Cascade)
  version        Int
  /// Predicate selecting which subjects this workflow governs (Zod-validated).
  matchCondition Json             @map("match_condition")
  /// { nodes, edges } authored in the editor (Zod-validated at publish).
  graph          Json
  /// DRAFT | PUBLISHED | ARCHIVED (a CHECK in the table).
  status         String           @default("DRAFT")
  publishedAt    DateTime?        @map("published_at") @db.Timestamptz(6)
  publishedBy    String?          @map("published_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  instances      ApprovalInstance[] @relation("InstanceVersion")

  @@unique([organizationId, id])
  @@unique([organizationId, workflowId, version])
  @@map("approval_workflow_version")
}

/// ExpenseOS's ApprovalInstance: one run of a published version over one subject.
model ApprovalInstance {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                  @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  workflowVersionId String                  @map("workflow_version_id") @db.Uuid
  workflowVersion   ApprovalWorkflowVersion @relation("InstanceVersion", fields: [organizationId, workflowVersionId], references: [organizationId, id], onDelete: Restrict)
  /// EXPENSE_REPORT | TRAVEL_REQUEST (a CHECK in the table).
  subjectType       String                  @map("subject_type")
  subjectId         String                  @map("subject_id") @db.Uuid
  /// RUNNING | APPROVED | REJECTED | CANCELLED (a CHECK in the table).
  status            String                  @default("RUNNING")
  cursor            Json
  /// The flattened graph actually executed — CallWorkflow nodes inlined at instantiation.
  effectiveGraph    Json?                   @map("effective_graph")
  parentInstanceId  String?                 @map("parent_instance_id") @db.Uuid
  parent            ApprovalInstance?       @relation("SubflowStack", fields: [organizationId, parentInstanceId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  children          ApprovalInstance[]      @relation("SubflowStack")
  callDepth         Int                     @default(0) @map("call_depth")
  startedAt         DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz(6)
  tasks             ApprovalTask[]

  @@unique([organizationId, id])
  @@index([organizationId, subjectType, subjectId])
  @@map("approval_instance")
}

/// ExpenseOS's ApprovalTask: one required approver at one node. VeloExpense: the table is
/// `approval_instance_task` until the ladder's `approval_task` is retired (w4-00d).
model ApprovalTask {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  instanceId         String           @map("instance_id") @db.Uuid
  instance           ApprovalInstance @relation(fields: [organizationId, instanceId], references: [organizationId, id], onDelete: Cascade)
  /// Node id within the version's graph that created this task.
  nodeId             String           @map("node_id")
  /// The database's key is composite (organization_id, assignee_user_id), as Receipt's
  /// uploader; the relation is on the id alone because User has no composite unique.
  assigneeUserId     String?          @map("assignee_user_id") @db.Uuid
  assignee           User?            @relation("ApprovalTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  label              String?
  /// PENDING | APPROVED | REJECTED | SKIPPED | EXPIRED (a CHECK in the table).
  status             String           @default("PENDING")
  decidedById        String?          @map("decided_by_id") @db.Uuid
  decidedBy          User?            @relation("ApprovalTaskDecider", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(6)
  note               String?
  /// Deadline (from the node's ttlBusinessDays) after which the sweep applies onExpire.
  expiresAt          DateTime?        @map("expires_at") @db.Timestamptz(6)
  escalationLevel    Int              @default(0) @map("escalation_level")
  deadlineReminderAt DateTime?        @map("deadline_reminder_at") @db.Timestamptz(6)
  /// Groups tasks forked by the same Parallel node (for the join policy).
  parallelGroup      String?          @map("parallel_group")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, assigneeUserId, status])
  @@index([organizationId, instanceId])
  @@map("approval_instance_task")
}

// ExpenseOS's `Delegation`, on VeloExpense's `delegation` (0008), which the ladder already
// reads. VeloExpense differences, mapped by the engine (w4-00b):
//   · from / to user (ExpenseOS: delegator / delegatee);
//   · inclusive calendar dates `starts_on` / `ends_on` (ExpenseOS: timestamps);
//   · revoked by `revoked_at` (ExpenseOS: an `active` flag);
//   · scope ALL | REPORTS, text under a CHECK (ExpenseOS's enum adds VCC).
// The database's keys are composite (0019); the relations are on the id alone.
model Delegation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  fromUserId     String    @map("from_user_id") @db.Uuid
  fromUser       User      @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toUserId       String    @map("to_user_id") @db.Uuid
  toUser         User      @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  /// ALL | REPORTS (a CHECK in the table).
  scope          String    @default("ALL")
  createdById    String    @map("created_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById    String?   @map("revoked_by_id") @db.Uuid
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("delegation")
}

// ExpenseOS's `PolicyViolationSeverity`, on the `policy_severity` Postgres enum VeloExpense's
// policy tables already use (0006). Same three values.
enum PolicyViolationSeverity {
  INFO
  WARNING
  BLOCK

  @@map("policy_severity")
}

// ExpenseOS's `PolicyRule` (w4-02b, d63), on `policy_rule` (0064): one row per rule
// instance of a kind from the registry (server/policy/kinds.ts). VeloExpense differences:
//   · `scope` is text under a CHECK: LINE | REPORT | AGGREGATE, and ExpenseOS's
//     TRAVEL_REQUEST since 0077 (w6-00);
//   · the six scope columns are scalars only. The database's keys are composite (0064),
//     ON DELETE RESTRICT; ported code reads and writes the ids and never walks the
//     relations. `roleId` names a role of the tenant since 0070 (w4-10c, d64).
model PolicyRule {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                  @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// FK-by-convention to a registered RuleKind in the policy engine.
  kindCode       String                  @map("kind_code")
  /// Denormalized from the kind for indexing/filtering. LINE | REPORT | AGGREGATE (a CHECK).
  scope          String
  enabled        Boolean                 @default(true)
  /// Overrides the kind's default severity.
  severity       PolicyViolationSeverity
  /// Predicate AST (for the PREDICATE kind); null for code kinds.
  condition      Json?
  /// Kind-specific params, validated at write time by the kind's schema.
  params         Json                    @default("{}")
  /// i18n catalog key for the violation message (EN + FR-CA enforced).
  messageKey     String                  @map("message_key")
  departmentId   String?                 @map("department_id") @db.Uuid
  jobLevelId     String?                 @map("job_level_id") @db.Uuid
  legalEntityId  String?                 @map("legal_entity_id") @db.Uuid
  businessUnitId String?                 @map("business_unit_id") @db.Uuid
  roleId         String?                 @map("role_id") @db.Uuid
  categoryId     String?                 @map("category_id") @db.Uuid
  effectiveFrom  DateTime                @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?               @map("effective_to") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?                 @map("created_by") @db.Uuid
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, enabled, scope, effectiveFrom])
  @@index([organizationId, categoryId])
  @@map("policy_rule")
}

// ExpenseOS's `ExpensePolicy` (w4-02c, d63/d65), on `expense_category_policy` (0065): one
// row per expense category, its limits (minor units of the policy currency) and receipt
// flag, read by the built-in rule kinds. VeloExpense differences:
//   · the table name, because `expense_policy` is VeloExpense's v1 rule table until the
//     cutover (w4-02d) drops it;
//   · per tenant; the database's key to the category is composite (0065), the relation
//     here is on the category id alone, as ported code reads it.
model ExpensePolicy {
  /// PK = categoryId (1:1 with ExpenseCategory).
  categoryId               String          @id @map("category_id") @db.Uuid
  organizationId           String          @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  category                 ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// When true, every line item in this category must carry at least one Receipt.
  receiptRequired          Boolean         @default(true) @map("receipt_required")
  /// Reserved (ExpenseOS Phase 3): force the approval lane for this category.
  approvalRequired         Boolean         @default(true) @map("approval_required")
  /// Per-transaction (single line item) ceiling. Null = no cap.
  perTransactionLimitMinor BigInt?         @map("per_transaction_limit_minor")
  dailyLimitMinor          BigInt?         @map("daily_limit_minor")
  monthlyLimitMinor        BigInt?         @map("monthly_limit_minor")
  annualLimitMinor         BigInt?         @map("annual_limit_minor")
  notes                    String?
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, categoryId])
  @@map("expense_category_policy")
}

// ExpenseOS's `PolicyViolation` (w4-02d), on VeloExpense's `policy_violation` (0006, reshaped
// to this by 0066): one finding of a rule instance against a report, on a line or an
// expense or the whole report — or, since 0077 (w6-00), against a travel request or one of its
// lines (ExpenseOS's `travelRequestId` / `travelLineId`; never both subjects, a CHECK).
// VeloExpense differences:
//   · scalars only for the report side; the database's keys are composite (0006, 0019,
//     0066, 0077);
//   · `data` is never null (the column's default is `{}`).
model PolicyViolation {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                  @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// Nullable since 0077: a violation is about a report OR a travel request (a CHECK).
  reportId       String?                 @map("report_id") @db.Uuid
  /// Optional expense-scope anchor (entry-level rules).
  expenseId      String?                 @map("expense_id") @db.Uuid
  lineItemId     String?                 @map("line_item_id") @db.Uuid
  /// The firing rule instance's id (`policy_rule.id`); a v1 kind name on rows written
  /// before the cutover.
  ruleCode       String                  @map("rule_code")
  severity       PolicyViolationSeverity
  /// The message KEY (`policy.labels.<key>`), rendered in the reader's locale; a sentence
  /// on rows written before the cutover.
  message        String
  /// Rule-specific structured payload — the values the message's placeholders read.
  data           Json                    @default("{}")
  resolvedAt     DateTime?               @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?                 @map("resolved_by_id") @db.Uuid
  resolveNote    String?                 @map("resolve_note")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  /// w6-00: ExpenseOS's travel subject (0077).
  travelRequestId String?                @map("travel_request_id") @db.Uuid
  travelRequest   TravelRequest?         @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  travelLineId    String?                @map("travel_line_id") @db.Uuid
  travelLine      TravelBudgetLine?      @relation(fields: [travelLineId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([travelRequestId])
  @@map("policy_violation")
}

/// ExpenseOS's `SavedView` (w4-08, migration 0067): a person's saved filter / sort / column
/// state for one list. VeloExpense: per tenant under RLS; the owner is a composite foreign
/// key in SQL, not a Prisma relation (nothing reads through it); one pinned default per owner
/// and list is also a partial unique index (`saved_view_one_default`).
model SavedView {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  /// Discriminates which directory this view belongs to (e.g. "people",
  /// "expenses", "cards"). Free-form string; validated in code rather than
  /// as a Postgres enum so new directories don't burn a migration.
  resource       String
  name           String
  /// Opaque view state — `{ scope, filters[], visibleColumns?, sort?, density?, groupBy? }`.
  /// Zod-validated at the tRPC boundary.
  state          Json
  pinned         Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, ownerId, resource, deletedAt], map: "saved_view_owner_resource_idx")
  @@map("saved_view")
}

/// w5-01 — ExpenseOS's `ReplyThread` (0073): maps an outbound notification back to its subject
/// so a reply (email, or a Slack thread from w5-02) becomes a COMMENT. One row per recipient ×
/// subject. Loose ids, as ExpenseOS's: the inbound path re-validates the subject and recipient.
/// VeloExpense: per tenant, under RLS.
model ReplyThread {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  subjectType    String   @map("subject_type")
  subjectId      String   @map("subject_id") @db.Uuid
  recipientId    String   @map("recipient_id") @db.Uuid
  /// sha256 of the raw email reply token (null until an email is sent)
  tokenHash      String?  @unique @map("token_hash")
  slackChannelId String?  @map("slack_channel_id")
  slackThreadTs  String?  @map("slack_thread_ts")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([recipientId, subjectType, subjectId])
  @@index([organizationId])
  @@index([slackChannelId, slackThreadTs])
  @@map("reply_thread")
}

// ── Travel (Wave 6, w6-00, migration 0077) ───────────────────────────────────
// ExpenseOS's `TravelPlace`, `TravelRequest`, `TravelCategory` and `TravelBudgetLine`
// (1e682dd6), field for field. VeloExpense differences, as the Wave 2 models have them:
//   · per tenant: composite keys in SQL; relations here name the id alone;
//   · ExpenseOS's enums (TravelRequestStatus, TravelTripType, TravelLineKind,
//     TravelPriceBasis, TravelPriceConfidence) are text under CHECKs, so those fields are
//     `String`;
//   · `currencyId` is the ISO code in `currency_code`;
//   · ExpenseOS's `NetSuiteAccount` is VeloExpense's `GlAccount`;
//   · `number` is minted per tenant by a trigger (0077), so a create omits it as ExpenseOS's
//     does — `dbgenerated` tells the client the database supplies it;
//   · `TravelPlace` is per tenant, so `placeId` is unique within the tenant.

/// ExpenseOS's TravelPlace: a Google place resolved once to the metro and airports SerpApi
/// prices, reused for every trip to it.
model TravelPlace {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// Google's durable handle — the exact key.
  placeId        String    @map("place_id")
  label          String
  city           String?
  country        String?
  /// SerpApi city kgmid, passed as departure_id/arrival_id.
  serpPlaceId    String?   @map("serp_place_id")
  airports       String[]  @default([])
  resolvedAt     DateTime  @default(now()) @map("resolved_at") @db.Timestamptz(6)
  /// Set when an admin corrects a mapping by hand, so a refresh cannot clobber it.
  pinnedById     String?   @map("pinned_by_id") @db.Uuid
  pinnedAt       DateTime? @map("pinned_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([organizationId, placeId])
  @@index([organizationId, city, country])
  @@index([resolvedAt])
  @@map("travel_place")
}

/// ExpenseOS's TravelRequest: draft → an estimate the traveller composes → approval → a trip.
model TravelRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// 'TRV-000001', per tenant, minted by the database (0077's trigger).
  number              String    @default(dbgenerated("NULL"))

  submitterId         String    @map("submitter_id") @db.Uuid
  submitter           User      @relation("TravelSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)

  purpose             String
  notes               String?

  destinationPlaceId  String?   @map("destination_place_id")
  destinationLabel    String    @map("destination_label")
  /// Free text — matches a PerDiemRate's city and seeds the hotel query.
  destinationCity     String?   @map("destination_city")
  destinationCountry  String?   @map("destination_country")
  /// SerpApi metro id, snapshotted at resolution.
  destinationSerpId   String?   @map("destination_serp_id")
  destinationAirports String[]  @default([]) @map("destination_airports")
  /// Set only when the traveller pinned one; overrides the metro id in the flight query.
  destinationAirport  String?   @map("destination_airport")

  originPlaceId       String?   @map("origin_place_id")
  originLabel         String?   @map("origin_label")
  originCity          String?   @map("origin_city")
  originCountry       String?   @map("origin_country")
  originSerpId        String?   @map("origin_serp_id")
  originAirports      String[]  @default([]) @map("origin_airports")
  originAirport       String?   @map("origin_airport")

  /// ROUND_TRIP | ONE_WAY | MULTI_CITY (a CHECK in the table).
  tripType            String    @default("ROUND_TRIP") @map("trip_type")
  departDate          DateTime  @map("depart_date") @db.Timestamptz(6)
  returnDate          DateTime? @map("return_date") @db.Timestamptz(6)
  includeCar          Boolean   @default(false) @map("include_car")

  /// DRAFT | SUBMITTED | APPROVED | REJECTED | RETURNED | CANCELLED (a CHECK in the table).
  status              String    @default("DRAFT")
  /// Loose in ExpenseOS (no relation, to keep the engine and its subjects apart); the
  /// database's key here is composite (0077), and only the scalar is described.
  approvalInstanceId  String?   @map("approval_instance_id") @db.Uuid
  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz(6)
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz(6)

  /// VeloExpense: the ISO code (`currency_code`), not a uuid.
  currencyId          String    @map("currency_code")
  currency            Currency  @relation("TravelRequestCurrency", fields: [currencyId], references: [code], onDelete: Restrict)
  /// The total AS APPROVED.
  approvedTotalMinor  BigInt?   @map("approved_total_minor")

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  budgetLines         TravelBudgetLine[]
  /// Reports built from this request.
  reports             ExpenseReport[]   @relation("ExpenseReportTravel")
  /// Policy violations raised against this estimate.
  policyViolations    PolicyViolation[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([submitterId, status])
  @@index([organizationId, status])
  @@index([departDate])
  @@map("travel_request")
}

/// ExpenseOS's TravelCategory: travel's own short taxonomy, with the `lineKind` that decides
/// which editor block a budget line opens.
model TravelCategory {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// Stable machine key; null for a category an admin created by hand.
  code              String?
  /// Locale-keyed display name. { en, fr-CA }
  label             Json
  icon              String?
  color             String?
  active            Boolean          @default(true)
  sortOrder         Int              @default(0) @map("sort_order")
  /// STANDARD | AIRFARE | LODGING | DEPARTMENT_MEAL | CAR_RENTAL | GROUND (a CHECK).
  lineKind          String           @default("STANDARD") @map("line_kind")
  /// The expense category this maps to, when there is one.
  expenseCategoryId String?          @map("expense_category_id") @db.Uuid
  expenseCategory   ExpenseCategory? @relation("TravelCategoryExpense", fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  /// Null falls back to the MAPPED expense category's account.
  glAccountId       String?          @map("gl_account_id") @db.Uuid
  glAccount         GlAccount?       @relation("TravelCategoryGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  budgetLines       TravelBudgetLine[] @relation("TravelBudgetCategory")

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([expenseCategoryId])
  @@index([glAccountId])
  @@map("travel_category")
}

/// ExpenseOS's TravelBudgetLine: one line of a request's estimate.
model TravelBudgetLine {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String          @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  travelRequestId    String          @map("travel_request_id") @db.Uuid
  travelRequest      TravelRequest   @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  categoryId         String          @map("category_id") @db.Uuid
  category           TravelCategory  @relation("TravelBudgetCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  /// STANDARD | AIRFARE | LODGING | DEPARTMENT_MEAL | CAR_RENTAL | GROUND (a CHECK).
  kind               String          @default("STANDARD")
  /// The kind's own fields (@expenseos/travel-lines). Minor amounts ride as digit strings.
  payload            Json?
  glAccountId        String?         @map("gl_account_id") @db.Uuid
  glAccount          GlAccount?      @relation("TravelBudgetGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  amountMinor        BigInt          @map("amount_minor")
  /// QUOTE | POLICY_CAP | PER_DIEM | MANUAL (a CHECK).
  basis              String
  /// BELOW_TYPICAL | TYPICAL | ABOVE_TYPICAL | UNKNOWN (a CHECK).
  confidence         String?
  /// The traveller's own words.
  notes              String?
  /// What the policy derived, when a human replaced it with their own figure.
  derivedAmountMinor BigInt?         @map("derived_amount_minor")
  /// Itinerary order.
  sortOrder          Int             @default(0) @map("sort_order")

  policyViolations   PolicyViolation[]

  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([travelRequestId])
  @@index([glAccountId])
  @@index([categoryId])
  @@map("travel_budget_line")
}

// ── Assistant (Wave 6, w6-03, migration 0078) ────────────────────────────────
// ExpenseOS's `AssistantConversation`, `AssistantMessage` and `AssistantFeedback`
// (1e682dd6), field for field. VeloExpense differences, as the travel models have them:
//   · per tenant: composite keys in SQL; relations here name the id alone;
//   · `reviewedBy` is a composite key to the person in SQL (ExpenseOS: a bare uuid); only the
//     scalar is described, as ExpenseOS's model has it.

/// ExpenseOS's AssistantConversation: one chat thread, owned by the person who started it.
model AssistantConversation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation("AssistantConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Model-generated after the first exchange; null until then.
  title          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  messages AssistantMessage[]
  feedback AssistantFeedback[]

  @@unique([organizationId, id])
  @@index([userId, updatedAt])
  @@map("assistant_conversation")
}

/// ExpenseOS's AssistantMessage: one turn, its content block array stored verbatim.
model AssistantMessage {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// 'user' | 'assistant', mirroring the Messages API role (a CHECK).
  role           String
  /// The content block array exactly as sent to / received from the API.
  content        Json
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  feedback AssistantFeedback[]

  @@unique([organizationId, id])
  @@index([conversationId, createdAt])
  @@map("assistant_message")
}

/// ExpenseOS's AssistantFeedback: a rating on one assistant turn, or a flag the assistant
/// raised about itself.
model AssistantFeedback {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The assistant turn being rated.
  messageId      String                @map("message_id") @db.Uuid
  message        AssistantMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Denormalised from the conversation so the review queue can filter by person.
  userId         String                @map("user_id") @db.Uuid
  user           User                  @relation("AssistantFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)
  /// 1–5. Nullable so a turn can be flagged without being scored.
  rating         Int?
  comment        String?
  /// Set by the ASSISTANT: OFF_TOPIC | NO_ANSWER_FOUND | UNSUPPORTED_CLAIM | null (a CHECK).
  flag           String?
  /// PENDING | REVIEWED | PROMOTED | DISMISSED (a CHECK).
  status         String                @default("PENDING")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt     DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?               @map("reviewed_by") @db.Uuid

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([rating])
  @@index([userId, createdAt])
  @@map("assistant_feedback")
}

// ── API keys (Wave 6, w6-04, migration 0079) ─────────────────────────────────
// ExpenseOS's `ApiKey`, `ApiKeyRequest` and `ApiKeyIdempotency` (1e682dd6), field for field.
// VeloExpense differences, as the assistant models have them:
//   · per tenant: composite keys in SQL; relations here name the id alone;
//   · `kind` is text with a CHECK (USER | PLATFORM), not a Prisma enum;
//   · the request log's coalescing key carries the tenant;
//   · `api_key_lookup` (0079's header): the one hatch, answering which tenant a token is in.

/// ExpenseOS's ApiKey: a credential that acts as a person. Only the token's hash is stored.
model ApiKey {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  /// USER | PLATFORM (a CHECK).
  kind               String
  name               String
  /// The token's public half: `vxe_u_<prefix>_<secret>`. Not secret.
  prefix             String    @unique
  /// SHA-256 of the full presented token.
  tokenHash          String    @unique @map("token_hash") @db.Char(64)
  userId             String?   @map("user_id") @db.Uuid
  user               User?     @relation("ApiKeyOwner", fields: [userId], references: [id], onDelete: SetNull)
  createdById        String    @map("created_by_id") @db.Uuid
  createdBy          User      @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  /// Scope strings from @expenseos/api-scopes. EMPTY MEANS NO ACTION PERMITTED.
  scopes             String[]  @default([])
  rateLimitPerMinute Int?      @map("rate_limit_per_minute")
  allowedIps         String[]  @default([]) @map("allowed_ips")
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  requests    ApiKeyRequest[]
  idempotency ApiKeyIdempotency[]

  @@unique([organizationId, id])
  @@index([userId])
  @@index([kind])
  @@index([createdById])
  @@index([revokedAt])
  @@map("api_key")
}

/// ExpenseOS's ApiKeyRequest: every call made with an API key, successful or not.
model ApiKeyRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  apiKeyId       String?   @map("api_key_id") @db.Uuid
  apiKey         ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  prefixTried    String?   @map("prefix_tried")
  actingUserId   String?   @map("acting_user_id") @db.Uuid
  operation      String
  toolName       String?   @map("tool_name")
  scopeRequired  String?   @map("scope_required")
  /// OK | DENIED_SCOPE | DENIED_PERMISSION | RATE_LIMITED | IP_BLOCKED | INVALID_KEY | EXPIRED
  /// | REVOKED | SUBJECT_REQUIRED | SUBJECT_NOT_ALLOWED | SUBJECT_UNKNOWN | ERROR (a CHECK).
  outcome        String
  statusCode     Int?      @map("status_code")
  durationMs     Int?      @map("duration_ms")
  request        Json?
  response       Json?
  ip             String?
  userAgent      String?   @map("user_agent")
  count          Int       @default(1)
  windowStart    DateTime? @map("window_start") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  /// The coalescing key (ExpenseOS's, with the tenant). NULLs stay distinct.
  @@unique([organizationId, outcome, ip, operation, windowStart], map: "api_key_request_outcome_ip_operation_window_start_key")
  @@index([apiKeyId, createdAt], map: "api_key_request_api_key_created_idx")
  @@index([actingUserId, createdAt], map: "api_key_request_acting_user_created_idx")
  @@index([outcome, createdAt], map: "api_key_request_outcome_created_idx")
  @@index([expiresAt])
  @@map("api_key_request")
}

/// ExpenseOS's ApiKeyIdempotency: replay protection for mutating API-key calls.
model ApiKeyIdempotency {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @default(dbgenerated("(NULLIF(current_setting('app.current_org'::text, true), ''::text))::uuid")) @map("organization_id") @db.Uuid
  apiKeyId       String   @map("api_key_id") @db.Uuid
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key            String
  requestHash    String   @map("request_hash") @db.Char(64)
  response       Json?
  /// IN_FLIGHT | COMPLETED (a CHECK).
  status         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@unique([apiKeyId, key])
  @@index([expiresAt])
  @@map("api_key_idempotency")
}
